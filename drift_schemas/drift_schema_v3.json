  "fixed_sql": [
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" TEXT NOT NULL, \"title\" TEXT NULL, \"content\" TEXT NOT NULL, \"note\" TEXT NULL, \"channel_id\" TEXT NULL, \"document_json\" TEXT NULL, \"tags\" TEXT NOT NULL DEFAULT '[]', \"is_pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_pinned\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"server_revision\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "channels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"channels\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"parent_id\" TEXT NULL REFERENCES channels (id), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attachments\" (\"id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"original_file_name\" TEXT NULL, \"relative_path\" TEXT NOT NULL, \"byte_size\" INTEGER NULL, \"created_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sync_outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_outbox\" (\"item_id\" TEXT NOT NULL, \"mutation_id\" TEXT NOT NULL, \"base_revision\" INTEGER NOT NULL, \"op\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"retry_count\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"item_id\"));"
        }
      ]
    },
    {
      "name": "sync_meta",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_meta\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
